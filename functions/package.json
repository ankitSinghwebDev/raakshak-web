{
  "name": "rakshak-functions",
  "description": "Rakshak Firebase Cloud Functions — Push notifications, OTP emails",
  "scripts": {
    "serve": "FIREBASE_CLI_DISABLE_UPDATE_CHECK=true npx firebase emulators:start --only functions,database,storage --config ../firebase.emulator.json",
    "deploy": "FIREBASE_CLI_DISABLE_UPDATE_CHECK=true npx firebase deploy --only functions --config ../firebase.json"
  },
  "engines": {
    "node": "20"
  },
  "main": "index.js",
  "devDependencies": {
    "firebase-tools": "^14.20.0"
  },
  "dependencies": {
    "firebase-admin": "^12.0.0",
    "firebase-functions": "^4.9.0",
    "nodemailer": "^6.9.0"
  }
}
